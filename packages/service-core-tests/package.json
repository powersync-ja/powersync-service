  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@powersync/service-module-postgres-storage": "workspace:*",
    "typescript": "catalog:"
  }
}
