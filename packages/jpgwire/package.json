{
  "name": "@powersync/service-jpgwire",
  "repository": "https://github.com/powersync-ja/powersync-service",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.21.28",
  "exports": "./dist/index.js",
  "license": "Apache-2.0",
  "files": [
    "dist/**/*",
    "ca/*.pem"
  ],
  "type": "module",
  "scripts": {
    "clean": "rm -r ./dist && tsc -b --clean",
    "build": "tsc -b",
    "build:tests": "tsc -b test/tsconfig.json",
    "test": "vitest",
    "test:upstream": "docker compose -f test/upstream/compose.yml up --build --abort-on-container-exit --exit-code-from node",
    "test:upstream:down": "docker compose -f test/upstream/compose.yml down --volumes --remove-orphans"
  },
  "dependencies": {
    "@powersync/service-jsonbig": "workspace:^",
    "@powersync/service-sync-rules": "workspace:^",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
